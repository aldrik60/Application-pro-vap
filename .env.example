VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Mode de distribution : 'full' (clients existants, Vercel) ou 'lite' (App Store / Google Play, version publique sans contenu commercial)
VITE_APP_MODE=full

# Clé publique VAPID pour Web Push (la clé privée reste côté serveur, jamais ici).
# Générer une paire avec : npx web-push generate-vapid-keys
# Tant que vide, la souscription push est désactivée côté UI.
VITE_VAPID_PUBLIC_KEY=
